{
  "name": "@kabukisolutions/patrika",
  "version": "0.10.0",
  "description": "Patrika is a static site generator. It reads markdown files and generates a static website using a user supplied `renderToString(ContentItem, Patrika) => Promise<string | string[]>` function. Patrika is minimal and framework agnostic, meant to be used with your favorite front-end framework.",
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "repository": "git@github.com:kabukisolutions/patrika.git",
  "author": "akshat1 <akshat.sh@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "patrika": "./bin/patrika.js"
  },
  "scripts": {
    "clean": "rm -rf lib/ coverage/ docs/",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "docs": "typedoc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "jiti": "^2.6.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "dependencies": {
    "@kabukisolutions/js-logger": "^4.0.0",
    "command-line-args": "^6.0.1",
    "command-line-usage": "^7.0.3",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "front-matter": "^4.0.2",
    "glob": "^13.0.0",
    "marked": "^17.0.1",
    "parseurl": "^1.3.3",
    "picodb": "^1.0.6",
    "slugify": "^1.6.6"
  }
}
